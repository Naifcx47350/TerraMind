# =============================================================================
# TerraMind — Caddyfile
# =============================================================================
# Caddy automatically obtains and renews a TLS certificate from Let's Encrypt.
#
# Before deploying:
#   1. Replace "your-domain.com" below with your actual domain.
#   2. Make sure your domain's DNS A record points to the server IP.
#   3. Ports 80 and 443 must be reachable from the internet (for ACME challenge).
#
# Local testing without a domain:
#   Replace the domain line with ":80" to run plain HTTP on port 80.
# =============================================================================

terramind-llm.com {
    # Forward all traffic to the nginx frontend container.
    # nginx handles /api/* → gateway:8000 internally (see docker/frontend/nginx.conf).
    # Pass the real client IP so nginx rate-limits per visitor, not per Caddy container.
    # (X-Forwarded-For is set by reverse_proxy automatically.)
    reverse_proxy frontend:80 {
        header_up X-Real-IP {remote_host}
    }
}
